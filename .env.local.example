# InFusion Agent environment configuration.
# Copy this file to .env.local and fill in the values. Placeholder values are
# enough to compile / type-check / `next build` and to run the app in Scripted
# Agent mode; real values are only needed to actually sign in against a running
# FusionAuth instance and to exercise the MCP tool calls end to end.

# --- FusionAuth instance -----------------------------------------------------

# Base URL of your FusionAuth instance (no trailing slash needed).
FUSIONAUTH_URL=http://localhost:9011

# The main "InFusion Agent" Application's OAuth credentials (FusionAuth admin ->
# Applications -> InFusion Agent -> OAuth). This is the app the employee logs in
# to; client_id is also the JWT `aud` on their access token, and the custom
# tools:* scopes are defined on this Application.
FUSIONAUTH_CLIENT_ID=00000000-0000-0000-0000-000000000000
FUSIONAUTH_CLIENT_SECRET=change-me

# The MCP tool server's OWN non-human identity, distinct from the user it acts
# for. In FusionAuth the client_credentials grant is ENTITY MANAGEMENT (a paid
# feature) — NOT an Application grant (Applications have no Client Credentials
# checkbox). So create an ENTITY named "InFusion Agent — MCP Tool Server" and use
# its Client Id + Client secret here. Leave these unset to run without the
# non-human-identity card (it degrades to an honest "not connected" state).
FUSIONAUTH_MCP_CLIENT_ID=00000000-0000-0000-0000-000000000000
FUSIONAUTH_MCP_CLIENT_SECRET=change-me

# The scope for the Entity's client_credentials token, naming a target entity and
# permission(s): target-entity:<entityId>:<permission>. The requesting entity
# needs a Grant on that target (the tool-server entity can target itself). Without
# this, FusionAuth rejects the grant and the card shows "not connected".
# FUSIONAUTH_MCP_SCOPE=target-entity:0b951ff0-aa0f-41e6-b497-b915c7f08c0a:tool_execution

# A FusionAuth API key (Settings -> API Keys). Used server-side for Two-Factor
# (step-up) and the optional /api/user directory lookup. Needs permission on:
#   POST /api/two-factor/status, POST /api/two-factor/start,
#   POST /api/two-factor/send,  POST /api/two-factor/login,
#   GET  /api/user            (directory lookups / consent checks)
FUSIONAUTH_API_KEY=change-me

# Optional: pin the tenant when your instance has more than one. Left unset for a
# single-tenant instance (the default tenant is used).
# FUSIONAUTH_TENANT_ID=

# --- App ---------------------------------------------------------------------

# Public base URL of THIS app. Used to build the OAuth redirect_uri
# (<APP_BASE_URL>/api/auth/callback), the same-origin redirect guards, and the
# URL the agent uses to reach its own MCP server (<APP_BASE_URL>/api/mcp).
APP_BASE_URL=http://localhost:3000

# Secret used to derive the AES key that encrypts the session cookie (jose
# EncryptJWT, dir + A256GCM). Any length works — it's SHA-256'd to 32 bytes.
# Generate one with:  openssl rand -base64 48
SESSION_SECRET=change-me-to-a-long-random-string

# --- Agent (optional) --------------------------------------------------------

# When set, the agent's planner becomes a real Claude tool-calling loop (the
# "Live LLM Agent" banner). When unset, the agent runs its deterministic scripted
# planner ("Scripted Agent" banner). The AUTHORIZATION behavior is identical
# either way — the auth layer never trusts the planner.
# ANTHROPIC_API_KEY=

# --- FusionAuth FGA (Permify) ------------------------------------------------

# REST base URL of the Permify server that answers the resource-level checks (which
# teams' payroll, whose PTO, which knowledge-base documents). The open-source server's
# default REST port is 3476:
#   docker run -p 3476:3476 -p 3478:3478 ghcr.io/permify/permify serve
# The app loads permify/schema.perm and writes the company graph itself on first use.
# Leave this unset to accept the default; with no server reachable at all, every check
# degrades to an in-memory app-code resolver and the UI shows an honest banner.
# (FGA provisioning hosted inside FusionAuth requires the Enterprise plan; local dev
# runs the open-source server.)
PERMIFY_URL=http://localhost:3476

# Optional: the Permify tenant id. The server ships with a pre-inserted `t1` for
# single-tenant use, which is what this demo assumes.
PERMIFY_TENANT=t1

# Optional: bearer token for a secured Permify deployment. The open-source server runs
# auth-less by default, so this is usually blank.
PERMIFY_TOKEN=

# Optional: how long to wait on a Permify call before falling back to the in-memory
# resolver, in milliseconds. Defaults to 2500 — a chat turn shouldn't hang because an
# optional service is down.
PERMIFY_TIMEOUT_MS=2500

# Optional: set to false once you are managing relations by hand in /admin, so the
# per-role demo seed (see lib/fga.ts `seedDemoGraphForUser`) never competes with your
# edits. Seeding already only ever runs for a user with NO relations at all, so a grant
# you revoke is not silently re-applied — this is the belt-and-braces switch.
INFUSIONAGENT_SEED_DEMO=true

# --- Roles -------------------------------------------------------------------

# The Application Role name that unlocks the /admin page. Defaults to "admin" if
# unset — set it to match whatever your FusionAuth application calls it.
# INFUSIONAGENT_ADMIN_ROLE=admin

# --- External tool (optional) -------------------------------------------------

# The agent's ONE outbound tool: `search_public_docs` asks a third-party MCP server about
# public documentation for the platform this app runs on. The default is DeepWiki's public
# server, which needs no key and no account — leave all of this unset and it just works.
# Unreachable? The turn degrades to the model's own knowledge and says so in the trace.
#
# The employee's access token is never forwarded to it (a third party can't verify a token
# minted for this app's Application), so nothing user-identifying leaves the network. What
# comes back is treated as untrusted content: displayed and attributed, never acted on.
EXTERNAL_MCP_URL=https://mcp.deepwiki.com/mcp

# The tool to call on that server.
EXTERNAL_MCP_TOOL=ask_question

# Comma-separated public repositories the tool may be asked about. Defaults to the
# technologies behind this demo, so "ask the outside world" means asking about the
# platform rather than trawling the web:
#   FusionAuth/fusionauth-site, FusionAuth/fusionauth-containers,
#   modelcontextprotocol/modelcontextprotocol, Permify/permify
# A repo DeepWiki hasn't indexed is tolerated — it answers from the rest. To add one,
# visit https://deepwiki.com/<owner>/<repo> and index it (it asks for a notify email).
EXTERNAL_MCP_REPOS=

# Per-call ceiling in milliseconds, covering the MCP handshake AND the call. Upstream
# answers are themselves model-generated and take roughly 10-20s over a large docs index,
# so this is generous but bounded — a chat turn must never hang on a third party.
# Defaults to 32000.
EXTERNAL_MCP_TIMEOUT_MS=32000

# Ceiling for a round trip to the app's OWN MCP server (handshake + call). Must stay
# ABOVE EXTERNAL_MCP_TIMEOUT_MS, because one of the tools behind it proxies outward and
# needs that budget of its own. Defaults to 55000.
MCP_CALL_TIMEOUT_MS=55000
